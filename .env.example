DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ecommerce_db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce_db

# Puerto del Postgres de docker-compose en tu maquina. Si el 5432 ya esta
# ocupado (otro Postgres local), cambialo (ej: 5433) y actualizá el puerto
# en DATABASE_URL de arriba tambien.
POSTGRES_PORT=5432

# Selector de proveedor: "OPENAI" o "GEMINI"
LLM_PROVIDER=GEMINI

LLM_API_KEY=tu_clave_de_api_aqui

# Nombre del modelo de lenguaje (ej: gemini-2.5-flash, gpt-4o-mini, etc.)
LLM_MODEL=gemini-2.5-flash

# Nombre del modelo de embeddings (ej: models/gemini-embedding-001 para Gemini, text-embedding-3-small para OpenAI)
EMBEDDING_MODEL=models/gemini-embedding-001