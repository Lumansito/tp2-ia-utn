# ==============================================================================
# DB Copilot — Configuración de Variables de Entorno (Archivo de Ejemplo)
# ==============================================================================
# Copiá este archivo como `.env` y completá las variables según tu entorno:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ecommerce_db
# Alternativa local:
# DATABASE_URL=sqlite:///data/ecommerce.db

# ------------------------------------------------------------------------------
# 2. Configuración Genérica de LLM y Embeddings
# ------------------------------------------------------------------------------
# Selector de proveedor: "OPENAI" o "GEMINI"
LLM_PROVIDER=OPENAI

# Clave de API unificada para el proveedor seleccionado
LLM_API_KEY=tu_clave_de_api_aqui

# Nombre del modelo de lenguaje (ej: gpt-4o-mini, gemini-2.5-flash, etc.)
LLM_MODEL=gpt-4o-mini

# Nombre del modelo de embeddings (opcional: text-embedding-3-small para OpenAI, models/embedding-001 para Gemini)
EMBEDDING_MODEL=text-embedding-3-small

