# ==============================================================================
# DB Copilot — Configuracion de Variables de Entorno (Archivo de Ejemplo)
# ==============================================================================
# Copia este archivo como `.env` y completa las variables:
#   cp .env.example .env
#
# Solo se usa Google Gemini (LLM y embeddings). No hay soporte para OpenAI ni
# vectorizador local de respaldo: si falta GOOGLE_API_KEY, la app no arranca.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (OBLIGATORIO)
# ------------------------------------------------------------------------------
# El esquema de DB Copilot se lee siempre en vivo de esta base: no hay carga
# manual de un .sql/.json. Formato:
#   postgresql+psycopg2://<usuario>:<contraseña>@<host>:<puerto>/<base>
DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/mi_base

# Alternativa para pruebas locales sin PostgreSQL instalado:
# DATABASE_URL=sqlite:///data/ecommerce.db

# Schema de PostgreSQL a introspeccionar (opcional; por defecto "public").
# DB_SCHEMA=public

# Opcional: motor de solo lectura para ejecutar los SELECT del agente. Si se
# define, conviene que sea un usuario de base de datos con permisos de SELECT
# unicamente, como capa extra de seguridad ademas de los guardrails de sqlglot.
# DATABASE_URL_READONLY=postgresql+psycopg2://lector:password@localhost:5432/mi_base

# Opcional: timeout de sentencias en milisegundos (solo PostgreSQL).
# DB_STATEMENT_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 2. Google Gemini (OBLIGATORIO)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=tu-api-key-de-gemini-aqui

# Los nombres de modelo de Gemini cambian con el tiempo. Confirmalos en
# https://ai.google.dev/gemini-api/docs/models antes de fijarlos para la
# defensa. Valores de referencia (revisar antes de usar):
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
