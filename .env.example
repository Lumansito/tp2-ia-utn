# ==============================================================================
# DB Copilot — Configuración de Variables de Entorno (Archivo de Ejemplo)
# ==============================================================================
# Copiá este archivo como `.env` y completá las variables según tu entorno:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (Connection String de PostgreSQL)
# ------------------------------------------------------------------------------
# Formato: postgresql+psycopg2://<usuario>:<contraseña>@<host>:<puerto>/<nombre_base>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ecommerce_db

# Alternativa (si querés usar la base sintética SQLite local de prueba):
# DATABASE_URL=sqlite:///data/ecommerce.db


# ------------------------------------------------------------------------------
# 2. Configuración de Proveedor LLM y Modelos
# ------------------------------------------------------------------------------
# Selector de proveedor: "OPENAI" o "GEMINI" (o "AUTO" para detección automática)
LLM_PROVIDER=OPENAI

# --- Configuración para OpenAI ---
OPENAI_API_KEY=sk-proj-tu-api-key-de-openai-aqui
OPENAI_MODEL=gpt-4o-mini

# --- Configuración para Google Gemini ---
# Modelos: gemini-3.5-flash-lite (recomendado), gemini-3.6-flash, gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash-lite
